# NearBy One NEXT hardware-audit defaults for Waveshare ESP32-C6-Touch-LCD-1.9.
# Select the target with: idf.py set-target esp32c6

# ESP-NimBLE only; do not bring Bluedroid into the first-pass scanner build.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Explicit even though ESP32-C6 currently defaults this on when supported.
CONFIG_IEEE802154_ENABLED=y
