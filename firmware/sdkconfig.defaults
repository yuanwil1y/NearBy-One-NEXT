# NearBy One NEXT production defaults for Waveshare ESP32-C6-Touch-LCD-1.9.
# Select the target with: idf.py set-target esp32c6

# Board flash is 8 MiB. Both default and BENCH_REQUIRED builds use the same
# explicit partition map; runtime product state is RAM-only and gets no
# persistence partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"

# ESP-NimBLE only; do not bring Bluedroid into the scanner build.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# ESP32-C6 BLE 5 extended discovery is part of the native input boundary.
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y

# Explicit even though ESP32-C6 currently defaults this on when supported.
CONFIG_IEEE802154_ENABLED=y

# LVGL v8.3: keep only the features used by the frozen NearBy UI. The draw
# buffer and LVGL heap remain bounded internal RAM; ESP32-C6 has no PSRAM
# Kconfig path in ESP-IDF v6.1 and this configuration does not request one.
CONFIG_LV_CONF_MINIMAL=y
# LV_SYMBOL_* strings are UTF-8 FontAwesome codepoints. LV_CONF_MINIMAL defaults
# text parsing to ASCII, which renders each 3-byte symbol as three placeholders.
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_TXT_ENC_ASCII=n
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=32
CONFIG_LV_DRAW_COMPLEX=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_BAR=y
CONFIG_LV_USE_BTN=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_SWITCH=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_USE_GPU_ARM2D=n
CONFIG_LV_USE_GPU_STM32_DMA2D=n
CONFIG_LV_USE_GPU_RA6M3_G2D=n
CONFIG_LV_USE_GPU_SWM341_DMA2D=n
CONFIG_LV_USE_GPU_NXP_PXP=n
CONFIG_LV_USE_GPU_NXP_VG_LITE=n
CONFIG_LV_USE_GPU_SDL=n
CONFIG_LV_USE_PNG=n
CONFIG_LV_USE_BMP=n
CONFIG_LV_USE_SJPG=n
CONFIG_LV_USE_GIF=n
CONFIG_LV_USE_QRCODE=n
CONFIG_LV_USE_FREETYPE=n
CONFIG_LV_USE_RLOTTIE=n
CONFIG_LV_USE_FFMPEG=n